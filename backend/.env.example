# Server Port
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/navix
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Environment
NODE_ENV=development

# Allowed CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Featherless AI configuration. Keep the API key server-side only.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Optional fallback: Gemini API Key for dynamic AI navigation reasoning
# Keep this secret - never expose in client-side code!
GEMINI_API_KEY=

# Optional seed admin credentials
SEED_ADMIN_EMAIL=admin@navix.local
SEED_ADMIN_PASSWORD=ChangeMe123!
